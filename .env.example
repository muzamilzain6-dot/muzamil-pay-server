# JazzCash credentials — PLACEHOLDERS ONLY. Never put real values here.
# Copy this file to .env on a deploy host OR use /admin/setup instead.
# (This server does not read .env by itself; hosts like Render inject
#  these as environment variables. See README.md.)
JAZZCASH_MERCHANT_ID=MC00000
JAZZCASH_PASSWORD=your-merchant-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
JAZZCASH_ENV=sandbox
BASE_URL=http://localhost:3000
PORT=3000
# SETUP_TOKEN=optional-fixed-token-for-admin-setup
